PORT=3000
HOST=127.0.0.1
DATA_DIR=./data
# Public deployments require HTTPS BASE_URL, HOST=0.0.0.0 and a long random ADMIN_TOKEN.
BASE_URL=
ADMIN_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Pilot only; 4-10 digit PIN. No real filing or automatic fax.
PHONE_PILOT=1
PILOT_PIN=
TEST_EMAIL=
OPENAI_API_KEY=
# Optional project for GPT-Live custom voice; does not change telephone TTS.
MIRKAM_LIVE_PROJECT_ID=
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=whisper-1
STT_MODE=openai
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy
TWILIO_TTS_VOICE=Google.he-IL-Standard-A
PROVIDER_TIMEOUT_MS=20000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Gmail replies are read from INBOX with existing app credentials; set 0 to disable.
MIRKAM_INBOUND_MAIL_ENABLED=1
PYTHON_BIN=python3
# Optional absolute path to a Hebrew TTF font:
HEBREW_FONT=
# Mirkam Line (new service). Never commit real credentials.
MIRKAM_DATA_DIR=./mirkam-data
MIRKAM_ADMIN_TOKEN=
MIRKAM_ADMIN_TOTP_SECRET=
DATA_ENCRYPTION_KEY=
MIRKAM_TEXT_MODEL=gpt-4.1
MIRKAM_AI_REQUESTS_PER_DAY=40
MIRKAM_CONTACT_LIMIT=5
MIRKAM_TIMEZONE=Asia/Jerusalem

# InterFAX paid subscription: server-only credentials. Existing pilot settings remain restricted.
# Configure through deploy/prepare-interfax.py on the VPS. No fax is sent by setup.
MIRKAM_FAX_PROVIDER=
# Set by prepare-interfax.py: live for subscription sending; pilot only with --pilot.
MIRKAM_FAX_MODE=
INTERFAX_USERNAME=
INTERFAX_PASSWORD=
MIRKAM_FAX_TEST_NUMBER=

# Built-in TTS voice for the telephone bridge; prompt-created Live IDs are not supported here.
MIRKAM_TTS_VOICE=
